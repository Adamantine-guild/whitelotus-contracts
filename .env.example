# WhiteLotus Contracts Environment Configuration Example
# Copy this file to .env and fill in your values
# Do not commit .env to version control

# Deployment Configuration
PRIVATE_KEY=your_private_key_here
RPC_URL=https://rpc.sepolia.org

# Admin Configuration (defaults to deployer if unset)
ADMIN_ADDRESS=0xYourAdminAddress

# Etherscan Verification (pass --verify to forge script)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Initial Round Configuration (optional — omit INIT_ROUND_TITLE to skip)
# INIT_ROUND_TITLE=MVP Round
# INIT_ROUND_METADATA=ipfs://bafy...metadata
# INIT_ROUND_BUDGET=10000000000000000000
# INIT_ROUND_FUNDING=1000000000000000000
